{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.mjs",
    "check:seo": "npm run build && node --test tests/seo-routes.check.mjs",
    "build": "node scripts/version-bump.js && vite build && cp -r public/static dist/ && bash scripts/build-check.sh",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "build:app": "npm run build && pm2 restart aqakorea"
  },
  "dependencies": {
    "hono": "^4.12.12",
    "http-proxy-middleware": "^4.0.0"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "express": "^5.2.1",
    "serve": "^14.2.6",
    "vite": "^6.3.5",
    "wrangler": "^3.99.0"
  }
}